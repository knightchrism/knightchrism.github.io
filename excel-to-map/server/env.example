# Copy these into the environment on the Ubuntu machine.
# Do not commit real keys. Do not paste keys into chat.

# SQLite file OUTSIDE this git checkout. The process must be able to create it.
QUOTA_DB=$HOME/dev/excel-map-quota/quota.sqlite

# Browser key: HTTP referrer restricted, Maps JavaScript API only.
# The server reveals it to the page only after a Dynamic Maps reservation.
GOOGLE_MAPS_BROWSER_KEY=

# Server key: IP restricted to this machine, Geocoding API only.
# It is never sent to the browser.
GOOGLE_GEOCODING_SERVER_KEY=

# Optional. Each value must be an integer from 1 through 9000.
# Higher values are rejected and Google stays off.
# QUOTA_CEILING_GEOCODING=9000
# QUOTA_CEILING_DYNAMIC_MAPS=9000
